# Server only. Never prefix a secret with VITE_.
GEMINI_API_KEY=
# gemini = Google AI Studio key; vertex = Google Cloud Vertex express-mode key
GOOGLE_GENAI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
# Localhost works without this flag. Enable only on hosting protected by access control.
RESEARCH_AGENT_ENABLED=false

# Production web capture requires protected hosting; localhost works without this flag.
WEB_CAPTURE_ENABLED=false

# Portfolio agent routing. Keep secrets server-side; never prefix with VITE_.
AGENT_PROVIDER=gemini
AGENT_SEARCH_PROVIDER=gemini
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro
# Optional: AGENT_SEARCH_PROVIDER=serper
SERPER_API_KEY=
# Optional: AGENT_TAGGING_PROVIDER=openai and AGENT_REASONING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional provider-managed HTML/JavaScript rendering, not a private-platform bypass.
SCRAPE_PROVIDER=native
FIRECRAWL_API_KEY=
