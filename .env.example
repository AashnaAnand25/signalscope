# Server only. Never prefix a secret with VITE_.
GEMINI_API_KEY=
# gemini = Google AI Studio key; vertex = Google Cloud Vertex express-mode key
GOOGLE_GENAI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
# Localhost works without this flag. Enable only on hosting protected by access control.
RESEARCH_AGENT_ENABLED=false

# Production web capture requires protected hosting; localhost works without this flag.
WEB_CAPTURE_ENABLED=false
